# --- Telegram ---
BOT_TOKEN=
# Telegram user id(ы) администратора(ов), через запятую. Узнать свой id можно,
# например, у @userinfobot
ADMIN_IDS=123456789
# id канала, куда бот публикует посты (бот должен быть админом с правом постить)
CHANNEL_ID=-1001234567890
# Необязательно: ссылка на группу обсуждений, показывается во всплывашке
# по кнопке "Обсудить"
DISCUSSION_GROUP_URL=
# Необязательно: numeric id группы обсуждений — нужен только для best-effort
# подсчёта комментариев (см. README, раздел "Подсчёт комментариев")
DISCUSSION_GROUP_ID=

# --- Gemini ---
GEMINI_API_KEY=
# Проверьте актуальные названия моделей для вашего ключа/региона
GEMINI_MODEL=gemini-2.5-flash

# --- GitHub ---
# Personal Access Token (classic или fine-grained, достаточно public_repo /
# read-only доступа к репозиториям) — нужен, чтобы не упираться в анонимные
# rate limits GitHub REST API
GITHUB_TOKEN=
# Секрет, указанный при создании GitHub webhook (Settings -> Webhooks)
GITHUB_WEBHOOK_SECRET=
# Список сторонних/трендовых репозиториев для периодического опроса,
# через запятую, формат owner/repo
TRACKED_REPOS=owner/repo1,owner/repo2
# Как часто опрашивать TRACKED_REPOS, в минутах
POLL_INTERVAL_MINUTES=60

# --- База данных ---
DATABASE_PATH=bot.db

# --- Веб-сервер (приём GitHub webhook + редиректы для трекинга кликов) ---
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
# Публичный https-адрес, за которым видно WEBHOOK_HOST:WEBHOOK_PORT
# (домен за reverse-proxy, туннель и т.п.). Обязателен, если хотите
# принимать реальные GitHub webhooks и/или трекать клики по кнопке GitHub.
PUBLIC_BASE_URL=https://your-domain.example.com
# Если PUBLIC_BASE_URL недоступен из интернета — поставьте false,
# кнопка "GitHub" будет вести на репозиторий напрямую, без трекинга кликов
ENABLE_CLICK_TRACKING=true

# --- Планировщик ---
# Таймзона для еженедельного отчёта (воскресенье, 09:00 по этой таймзоне)
TIMEZONE=Europe/Moscow
